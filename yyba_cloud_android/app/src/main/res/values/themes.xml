<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YybaCloud" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialCardViewStyle">@style/Widget.Yyba.Card</item>
        <item name="materialButtonStyle">@style/Widget.Yyba.Button</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Theme.YybaCloud.NoActionBar" parent="Theme.YybaCloud" />

    <style name="Theme.YybaCloud.Dark" parent="Theme.YybaCloud">
        <item name="android:statusBarColor">#CC000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
