<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yyba.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_info"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_sm"
                            android:layout_height="@dimen/icon_sm"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_server"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvServer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Yyba.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="@string/settings"
                app:icon="@drawable/ic_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Yyba.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/logout"
                app:icon="@drawable/ic_logout" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Yyba.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    style="@style/Yyba.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="@string/cloud_info" />

                <GridLayout
                    android:id="@+id/gridCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileAlbum"
                        style="@style/Widget.Yyba.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_category_album"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <ImageView
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_photo"
                                app:tint="@color/category_album" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/category_album"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileVideo"
                        style="@style/Widget.Yyba.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_category_video"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <ImageView
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_video"
                                app:tint="@color/category_video" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/category_video"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileDocument"
                        style="@style/Widget.Yyba.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_category_document"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <ImageView
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_document"
                                app:tint="@color/category_document" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/category_document"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileAudio"
                        style="@style/Widget.Yyba.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_category_audio"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <ImageView
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_audio"
                                app:tint="@color/category_audio" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/category_audio"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrash"
                        style="@style/Widget.Yyba.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnSpan="2"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/spacing_xs"
                        android:text="@string/cloud_trash"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="@color/text_secondary" />
                </GridLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Yyba.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    app:cardBackgroundColor="@color/surface_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/tvUnsyncedPhotos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_photo"
                            app:drawableTint="@color/category_album" />

                        <TextView
                            android:id="@+id/tvUnsyncedVideos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_video"
                            app:drawableTint="@color/category_video" />

                        <TextView
                            android:id="@+id/tvUnsyncedAudio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_audio"
                            app:drawableTint="@color/category_audio" />

                        <TextView
                            android:id="@+id/tvSyncStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:text="@string/sync_idle"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:drawableStartCompat="@drawable/ic_sync"
                            app:drawableTint="@color/text_secondary" />

                        <ProgressBar
                            android:id="@+id/progressSync"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:max="100"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvSyncProgressDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSync"
                    style="@style/Widget.Yyba.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/sync_now"
                    app:icon="@drawable/ic_sync" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
