<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.yyba.cloud.launcher.MainController">
    <top>
        <VBox spacing="8" style="-fx-padding: 16;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ImageView fx:id="headerLogo" fitHeight="36" fitWidth="36" preserveRatio="true"/>
                <Label text="悠悠爸家庭云盘 - 服务端管理" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="服务状态:"/>
                <Label fx:id="statusLabel" text="已停止" style="-fx-text-fill: #666;"/>
                <Label text="访问地址:"/>
                <Label fx:id="urlLabel" text="-"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-padding: 0 16 16 16;">
            <Tab text="服务配置">
                <VBox spacing="12" style="-fx-padding: 16;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="端口:" minWidth="80"/>
                        <TextField fx:id="portField" prefWidth="120"/>
                        <Button fx:id="startBtn" text="启动服务" onAction="#onStartServer"/>
                        <Button fx:id="stopBtn" text="停止服务" onAction="#onStopServer"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="存储目录:" minWidth="80"/>
                        <TextField fx:id="storagePathField" HBox.hgrow="ALWAYS"/>
                        <Button text="浏览" onAction="#onChooseStorage"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="灾备目录:" minWidth="80"/>
                        <TextField fx:id="backupPathField" HBox.hgrow="ALWAYS"/>
                        <Button text="浏览" onAction="#onChooseBackup"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <CheckBox fx:id="backupEnabledCheck" text="启用灾备目录"/>
                        <Button text="保存配置" onAction="#onSaveConfig"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="账号注册">
                <VBox spacing="12" style="-fx-padding: 16;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="用户名:" minWidth="80"/>
                        <TextField fx:id="regUsernameField" prefWidth="240"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="密码:" minWidth="80"/>
                        <PasswordField fx:id="regPasswordField" prefWidth="240"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="确认密码:" minWidth="80"/>
                        <PasswordField fx:id="regConfirmField" prefWidth="240"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="昵称:" minWidth="80"/>
                        <TextField fx:id="regDisplayNameField" prefWidth="240"/>
                    </HBox>
                    <Button text="注册账号" onAction="#onRegister"/>
                    <Label text="注册后将在存储目录下自动创建以用户名命名的文件夹" wrapText="true"
                           style="-fx-text-fill: #888;"/>
                </VBox>
            </Tab>
            <Tab text="用户管理">
                <VBox spacing="12" style="-fx-padding: 16;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button text="刷新" onAction="#onRefreshUsers"/>
                        <Button text="添加账号" onAction="#onAddUser"/>
                    </HBox>
                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" prefHeight="280"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="enableUserBtn" text="启用选中" onAction="#onEnableUser" disable="true"/>
                        <Button fx:id="disableUserBtn" text="禁用选中" onAction="#onDisableUser" disable="true"/>
                        <Button fx:id="resetPasswordBtn" text="重置密码" onAction="#onResetPassword" disable="true"/>
                    </HBox>
                    <Label text="添加账号将创建普通成员；禁用后该用户无法登录 Web / Android。" wrapText="true"
                           style="-fx-text-fill: #888;"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
